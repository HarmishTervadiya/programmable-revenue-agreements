# Protocol mode: devnet (default, real on-chain transactions) or mock (offline demo).
# VITE_PROTOCOL_MODE=devnet
# Devnet program (Anchor.toml [programs.devnet]).
VITE_PROGRAM_ID=2iEFwZ8qPjvEfSAtHqE7G7apQo9tVKFsiLrdAFC5sXop
# Helius devnet RPC (preferred): when set, the app uses
# https://devnet.helius-rpc.com/?api-key=<key> instead of VITE_SOLANA_RPC.
# Get a key at https://dev.helius.xyz — keep it in local .env (gitignored).
# VITE_HELIUS_API_KEY=
# Solana RPC endpoint (used only when no Helius key is set).
VITE_SOLANA_RPC=https://api.devnet.solana.com
# 6-decimal USDC mint on devnet (create once, fund test wallets). Required for
# creating agreements and buying shares; reads/claims still work where accounts exist.
VITE_PAYMENT_MINT=
# Explorer cluster slug for tx links.
VITE_EXPLORER_CLUSTER=devnet
